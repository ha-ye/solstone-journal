      "cleanup_state",
      "contract_version",
      "duration_ms",
      "finished_at",
      "proof",
      "reason",
      "run_id",
      "state",
      "type"
    ]
  },
  "record_types": [
    "attempt_started",
    "proof_terminal",
    "attempt_terminal"
  ],
  "retry_eligible_terminals": [
    {
      "proofs": null,
