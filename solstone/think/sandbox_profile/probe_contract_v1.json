        "capability_not_ready",
        "content_mismatch",
        "deadline_exceeded",
        "remote_rejected",
        "response_invalid",
        "usage_invalid"
      ]
    },
    "spb": {
      "checks": [
        "spb.repository_initialized",
        "spb.snapshot_created",
        "spb.snapshot_confirmed",
        "spb.restore_match",
